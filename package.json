{
  "name": "creatures",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @creatures/activity build && pnpm --filter @creatures/worker build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "fixtures:capture": "pnpm --filter @creatures/worker exec node scripts/capture-fixtures.mjs",
    "sim": "node packages/sim/scripts/run.mjs",
    "sim:quick": "node packages/sim/scripts/run.mjs --quick",
    "scalars": "node packages/sim/scripts/scalars.mjs",
    "patch-notes": "node packages/sim/scripts/patch-notes.mjs",
    "analyze": "node packages/sim/scripts/analyze.mjs",
    "sim:live": "node packages/sim/scripts/sim-live.mjs",
    "sim:journey": "node packages/sim/scripts/journey.mjs",
    "sim:curve": "node packages/sim/scripts/curve.mjs",
    "sim:supplies": "node packages/sim/scripts/supplies.mjs",
    "sim:weather": "node packages/sim/scripts/weather.mjs",
    "sim:creatures": "node packages/sim/scripts/creatures.mjs",
    "sim:economy": "node packages/sim/scripts/economy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
