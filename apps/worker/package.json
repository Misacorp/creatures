{
  "name": "@creatures/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "wrangler types --strict-vars=false --check && tsc --noEmit -p tsconfig.json",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
    "test": "vitest run && node --test 'scripts/*.test.mjs'",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@creatures/engine": "workspace:*",
    "@creatures/game": "workspace:*",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
