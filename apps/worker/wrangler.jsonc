{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creatures",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../activity/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "GUILD_WORLD", "class_name": "GuildWorld" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GuildWorld"] }],
  // Secrets are set by CI (Cloudflare Worker secrets) or in .dev.vars locally; never committed.
  "secrets": { "required": ["DISCORD_CLIENT_SECRET", "DISCORD_BOT_TOKEN"] },
  // VERSION is overridden at deploy time: wrangler deploy --var VERSION:<git sha>
  "vars": {
    "ENVIRONMENT": "local",
    "DISCORD_CLIENT_ID": "000000000000000000",
    "VERSION": "dev"
  },
  "env": {
    "staging": {
      "name": "creatures-staging",
      "durable_objects": { "bindings": [{ "name": "GUILD_WORLD", "class_name": "GuildWorld" }] },
      "secrets": { "required": ["DISCORD_CLIENT_SECRET", "DISCORD_BOT_TOKEN"] },
      "durable_objects": { "bindings": [{ "name": "GUILD_WORLD", "class_name": "GuildWorld" }] },
      "secrets": { "required": ["DISCORD_CLIENT_SECRET", "DISCORD_BOT_TOKEN"] },
      "routes": [{ "pattern": "creatures-staging.misacorp.dev", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "staging",
        "DISCORD_CLIENT_ID": "1558536384380145734",
        "VERSION": "dev"
      }
    },
    "production": {
      "name": "creatures",
      "durable_objects": { "bindings": [{ "name": "GUILD_WORLD", "class_name": "GuildWorld" }] },
      "secrets": { "required": ["DISCORD_CLIENT_SECRET", "DISCORD_BOT_TOKEN"] },
      "durable_objects": { "bindings": [{ "name": "GUILD_WORLD", "class_name": "GuildWorld" }] },
      "secrets": { "required": ["DISCORD_CLIENT_SECRET", "DISCORD_BOT_TOKEN"] },
      "routes": [{ "pattern": "creatures.misacorp.dev", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "DISCORD_CLIENT_ID": "1558533284072267896",
        "VERSION": "dev"
      }
    }
  }
}
