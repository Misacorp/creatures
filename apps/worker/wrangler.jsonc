{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creatures",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../activity/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // VERSION is overridden at deploy time: wrangler deploy --var VERSION:<git sha>
  "vars": {
    "ENVIRONMENT": "local",
    "DISCORD_CLIENT_ID": "000000000000000000",
    "VERSION": "dev"
  },
  "env": {
    "staging": {
      "name": "creatures-staging",
      "routes": [{ "pattern": "creatures-staging.misacorp.dev", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "staging",
        "DISCORD_CLIENT_ID": "REPLACE_WITH_DEV_APP_CLIENT_ID",
        "VERSION": "dev"
      }
    },
    "production": {
      "name": "creatures",
      "routes": [{ "pattern": "creatures.misacorp.dev", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "DISCORD_CLIENT_ID": "REPLACE_WITH_PROD_APP_CLIENT_ID",
        "VERSION": "dev"
      }
    }
  }
}
