{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creatures",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../activity/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GUILD_WORLD", "class_name": "GuildWorld" },
      { "name": "GUILD_DIRECTORY", "class_name": "GuildDirectory" },
      { "name": "FEEDBACK_INBOX", "class_name": "FeedbackInbox" }
    ]
  },
  // Environments inherit migrations (wrangler treats the key as inheritable), so v3 applies to all three.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GuildWorld"] },
    { "tag": "v2", "new_sqlite_classes": ["GuildDirectory"] },
    { "tag": "v3", "new_sqlite_classes": ["FeedbackInbox"] }
  ],
  // Secrets are set by CI (Cloudflare Worker secrets) or in .dev.vars locally; never committed.
  // OPS_TOKEN (the ops report's bearer token) is optional on purpose: without it the report route 404s.
  "secrets": { "required": ["DISCORD_CLIENT_SECRET", "DISCORD_BOT_TOKEN"] },
  // VERSION and BRANCH are overridden at deploy time: wrangler deploy --var VERSION:<git sha>
  // --var BRANCH:<branch name>. BRANCH shows in the game's footer, so Misa can see what is on staging.
  // LEET_SOURCE: "http" reads the leet bot API at LEET_API_URL with the LEET_API_KEY secret (staging
  // and production); "mock" simulates leets (local dev). Any other value disables the sync.
  // RAID_PRACTICE: "on" turns on the practice finale (POST /api/raid/practice, staging only); any
  // other value, production included, makes that route answer 404.
  // DEV_TOOLS: "on" turns on the dev tools (/api/dev/*, the dev clock; staging only, see
  // docs/design/dev-tools.md); any other value, production included, makes every /api/dev route answer
  // 404 and ignores a stored dev clock offset. A test pins production and the top level to "off".
  // DISCORD_PUBLIC_KEY: the Discord app's public key (hex, not a secret). The deploy job fills it from
  // Discord's verify_key; empty (or not 64 hex characters) turns POST /api/discord/interactions off (404),
  // which also turns off /feedback (docs/design/feedback.md).
  "vars": {
    "DISCORD_PUBLIC_KEY": "",
    "ENVIRONMENT": "local",
    "DISCORD_CLIENT_ID": "000000000000000000",
    "VERSION": "dev",
    "BRANCH": "dev",
    "LEET_SOURCE": "mock",
    "LEET_API_URL": "",
    "RAID_PRACTICE": "off",
    "DEV_TOOLS": "off"
  },
  "env": {
    "staging": {
      "name": "creatures-staging",
      "durable_objects": {
        "bindings": [
          { "name": "GUILD_WORLD", "class_name": "GuildWorld" },
          { "name": "GUILD_DIRECTORY", "class_name": "GuildDirectory" },
          { "name": "FEEDBACK_INBOX", "class_name": "FeedbackInbox" }
        ]
      },
      "secrets": { "required": ["DISCORD_CLIENT_SECRET", "DISCORD_BOT_TOKEN"] },
      "routes": [{ "pattern": "creatures-staging.misacorp.dev", "custom_domain": true }],
      "vars": {
        "DISCORD_PUBLIC_KEY": "",
        "ENVIRONMENT": "staging",
        "DISCORD_CLIENT_ID": "1558536384380145734",
        "VERSION": "dev",
        "BRANCH": "dev",
        "LEET_SOURCE": "http",
        "LEET_API_URL": "https://o0q1uz3be0.execute-api.eu-north-1.amazonaws.com",
        "RAID_PRACTICE": "on",
        "DEV_TOOLS": "on"
      }
    },
    "production": {
      "name": "creatures",
      "durable_objects": {
        "bindings": [
          { "name": "GUILD_WORLD", "class_name": "GuildWorld" },
          { "name": "GUILD_DIRECTORY", "class_name": "GuildDirectory" },
          { "name": "FEEDBACK_INBOX", "class_name": "FeedbackInbox" }
        ]
      },
      "secrets": { "required": ["DISCORD_CLIENT_SECRET", "DISCORD_BOT_TOKEN"] },
      "routes": [{ "pattern": "creatures.misacorp.dev", "custom_domain": true }],
      "vars": {
        "DISCORD_PUBLIC_KEY": "",
        "ENVIRONMENT": "production",
        "DISCORD_CLIENT_ID": "1558533284072267896",
        "VERSION": "dev",
        "BRANCH": "dev",
        "LEET_SOURCE": "http",
        "LEET_API_URL": "https://rwozj697u0.execute-api.eu-north-1.amazonaws.com",
        "RAID_PRACTICE": "off",
        "DEV_TOOLS": "off"
      }
    }
  }
}
